        ],
        "url": "{{baseUrl}}/api/menu-items/{{menuItemId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Margherita Pizza\",\n  \"price\": 15,\n  \"available\": true,\n  \"category\": \"main\",\n  \"restaurant\": \"{{restaurantId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Price updated\", () => pm.expect(pm.response.json().price).to.eql(15));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Verify restaurant update persisted",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/restaurants/{{restaurantId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
