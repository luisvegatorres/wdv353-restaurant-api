{
  "info": {
    "name": "WDV353 Restaurant API",
    "description": "Run in order against the local assignment API. Creates and deletes only this run\u2019s sample records.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "restaurantId",
      "value": ""
    },
    {
      "key": "menuItemId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Create restaurant",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/restaurants",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Olive Kitchen\",\n  \"cuisine\": \"Italian\",\n  \"rating\": 4.5,\n  \"isOpen\": true,\n  \"openedOn\": \"2024-06-01\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"restaurantId\", pm.response.json()._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 List restaurants",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/restaurants"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Get restaurant by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/restaurants/{{restaurantId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Replace restaurant",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/restaurants/{{restaurantId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Olive Kitchen\",\n  \"cuisine\": \"Italian\",\n  \"rating\": 5,\n  \"isOpen\": true,\n  \"openedOn\": \"2024-06-01\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Rating updated\", () => pm.expect(pm.response.json().rating).to.eql(5));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Create menu item",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/menu-items",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Margherita Pizza\",\n  \"price\": 12.5,\n  \"available\": true,\n  \"category\": \"main\",\n  \"restaurant\": \"{{restaurantId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"menuItemId\", pm.response.json()._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 List menu items",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/menu-items"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Get populated menu item",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/menu-items/{{menuItemId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Restaurant populated\", () => pm.expect(pm.response.json().restaurant.name).to.eql(\"Olive Kitchen\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Replace menu item",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
